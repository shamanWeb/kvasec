#!/bin/sh
# ---------------------------------------------------------------------------
# Сброс немаркированных соединений LAN → KVAS_LIST.
#
# Соединение, открытое, пока KVAS_MARK пуста/пересобирается (reload NDM-firewall,
# kvas route refresh, update_iptables), получает connmark 0, а KVAS_MARK пропускает
# не-NEW пакеты по restore-mark ('! NEW → RETURN') — такое соединение до закрытия
# ходит МИМО туннеля, с IP провайдера (keep-alive живут часами). Рвём их — клиент
# переоткроет соединение уже с меткой.
#
# Не трогаем: адреса самого роутера; устройства в режиме «Напрямую»
# (route_excluded_ip в kvas.conf — IP, подсеть или диапазон a-b) — они идут мимо
# туннеля НАМЕРЕННО; клиентов сегментов, у которых нет прыжка в KVAS_MARK (гостевая
# сеть не в INFACE_GUEST_ENT и т.п.): их трафик законно без метки, и сброс рвал бы
# им соединения при каждой пересборке правил.
# Вывод: число сброшенных соединений. Используют сторож S99kvas-awg-route,
# kvas route refresh, update_iptables.
# ---------------------------------------------------------------------------
# conntrack/ipset — в /opt/sbin; из CGI и cron PATH может быть урезан
export PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"
CONF=${KVAS_CONF_FILE:-/opt/etc/kvas.conf}
SET=${IPSET_TABLE_NAME:-KVAS_LIST}

command -v conntrack >/dev/null 2>&1 || { echo 0; exit 0; }

# Интерфейсы с прыжком в KVAS_MARK (шаблоны iptables: br0, xfrms+). Нет прыжков —
# метить нечего, сбрасывать тоже.
routed=$(iptables -w -t mangle -S PREROUTING 2>/dev/null | awk '/-j KVAS_MARK/ { for (i = 1; i < NF; i++) if ($i == "-i") print $(i + 1) }' | tr '\n' ' ')
# iptables -S на Keenetic обрывается на match'ах прошивки (ndmmark), а прыжки kvas — в
# конце цепочки. Не прочитали, но KVAS_MARK жива — считаем маршрутизируемым LAN-мост br0.
if [ -z "${routed% }" ] && iptables -w -t mangle -S KVAS_MARK 2>/dev/null | grep -q -- '--save-mark'; then
    routed="br0"
fi
[ -n "${routed% }" ] || { echo 0; exit 0; }

# Исключения: адреса роутера (/32), подсети интерфейсов без прыжка, route_excluded_ip.
skip=$(ip -o -4 addr show 2>/dev/null | awk -v pats="$routed" '
    { name = $2; sub(/@.*/, "", name); ip = $4; sub(/\/.*/, "", ip); print ip "/32"
      if (name == "lo") next
      n = split(pats, p, " "); hit = 0
      for (i = 1; i <= n; i++) {
          q = p[i]
          if (q ~ /\+$/) { q = substr(q, 1, length(q) - 1); if (index(name, q) == 1) hit = 1 }
          else if (name == q) hit = 1
      }
      if (!hit) print $4 }' | tr '\n' ' ')
skip="$skip $(grep '^route_excluded_ip=' "$CONF" 2>/dev/null | cut -d= -f2 | tr '+' ' ')"

conntrack -L -m 0 2>/dev/null | awk -v skip="$skip" '
    # Локальный массив назван не «a» — не полагаемся на затенение глобального split(skip, a).
    function ip2n(ip,   oct) { split(ip, oct, "."); return ((oct[1] * 256 + oct[2]) * 256 + oct[3]) * 256 + oct[4] }
    # Диапазоны [lo, hi] из IP, IP/маски и a-b; арифметика целочисленная (busybox awk без битовых операций).
    BEGIN { n = split(skip, a, " ")
        for (i = 1; i <= n; i++) {
            t = a[i]
            if (t ~ /-/) { split(t, r, "-"); lo[i] = ip2n(r[1]); hi[i] = ip2n(r[2]) }
            else if (t ~ /\//) { split(t, c, "/"); sz = 1; for (k = c[2]; k < 32; k++) sz *= 2   # без ^: в busybox awk без math его нет
                b = ip2n(c[1]); lo[i] = int(b / sz) * sz; hi[i] = lo[i] + sz - 1 }
            else { lo[i] = hi[i] = ip2n(t) }
        } }
    function skipped(ip,   v, i) { v = ip2n(ip); for (i = 1; i <= n; i++) if (v >= lo[i] && v <= hi[i]) return 1; return 0 }
    { s = d = ""
      for (i = 1; i <= NF; i++) {
          if (s == "" && $i ~ /^src=/) s = substr($i, 5)
          else if (d == "" && $i ~ /^dst=/) d = substr($i, 5)
      }
      if (s != "" && d != "" && !seen[d " " s]++ && !skipped(s)) print d, s }' \
| sort | {
    last=''; hit=1
    while read -r d s; do
        if [ "$d" != "$last" ]; then last=$d; ipset test "$SET" "$d" >/dev/null 2>&1; hit=$?; fi
        [ "$hit" -eq 0 ] && conntrack -D -m 0 -s "$s" -d "$d" >/dev/null 2>&1 && echo x
    done
} | grep -c x || true
