#!/bin/sh
# Generate dnsmasq rules for manually blocked domains. `address=/.domain/…`
# covers the domain itself and every subdomain, unlike a hosts-file entry.
set -eu

BLOCK_LIST=${KVAS_BLOCK_LIST:-/opt/etc/adblock/block.list}
DNS_FILE=${KVAS_PARENTAL_DNS_FILE:-/opt/etc/dnsmasq.d/kvas-parental.dnsmasq}
TMP_FILE="${DNS_FILE}.tmp.$$"

normalize_domain() {
    value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$value" in
        \*.*) value=${value#\*.} ;;
    esac
    value=${value%.}
    printf '%s\n' "$value"
}

is_domain() {
    case "$1" in
        ''|.*|*.|*..*|*[!a-z0-9.-]*) return 1 ;;
    esac
    printf '%s\n' "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
}

mkdir -p "$(dirname "$DNS_FILE")"
{
    if [ -f "$BLOCK_LIST" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ''|'#'*) continue ;; esac
            domain=$(normalize_domain "$line")
            is_domain "$domain" || continue
            printf 'address=/.%s/0.0.0.0\n' "$domain"
        done < "$BLOCK_LIST"
    fi
} > "$TMP_FILE"
mv -f "$TMP_FILE" "$DNS_FILE"
