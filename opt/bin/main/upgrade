#!/bin/sh
#--------------------------------------------------------------------------------------------------------------
#
#	Файл обновления пакета
#
#--------------------------------------------------------------------------------------------------------------

# по умолчанию включаем режим обновления KVASECа

#--------------------------------------------------------------------------------------------------------------
# Аргументы запуска данного файла
#--------------------------------------------------------------------------------------------------------------
# пусто 	- обычный режим проверки версии обновления
# force  	- режим с полным удалением пакета и принудительным обновлением, даже если версии одинаковые
# rollback 	- режим отката на предыдущую версию пакета, которая есть в релизах на GitHub
# full 		- полное удаление пакета со всеми файлами конфигурации, может задаваться вместе с force или rollback
#--------------------------------------------------------------------------------------------------------------
#	Функции обновления пакета
#--------------------------------------------------------------------------------------------------------------
set_escapes(){
# Устанавливаем эскейп-последовательности
# для управления опциями экрана терминала
	RED="\033[1;31m";
	GREEN="\033[1;32m";
	BLUE="\033[36m";
	NOCL="\033[m";
	QST="${RED}?${NOCL}"
}
WGET='/opt/bin/wget -q --no-check-certificate'
# Вы полняем команду отключения DNS провайдера без перезагрузки и выхода из сессии
rci_post()($WGET -qO - --post-data="$1" localhost:79/rci/ > /dev/null 2>&1)


has_no_internet_here(){
#	Если в возвращаемых аргументах нет false значит интернет присутствует
	# test -z "$(curl -s "localhost:79/rci/show/internet/status" \
	# | jq -r 'select(.enabled==true and .reliable==true and ."gateway-accessible"==true and ."captive-accessible"==true and ."dns-accessible"==true and .internet==true)')"

	# curl -s "localhost:79/rci/show/internet/status" \
	# 	| grep -E 'reliable|gateway-accessible|dns-accessible|internet|enabled|captive-accessible' \
	# 	| grep -q false
	curl -s "localhost:79/rci/show/internet/status" \
		| grep -E 'gateway-accessible|dns-accessible|internet|captive-accessible' \
		| grep -q false
}
#--------------------------------------------------------------------------------------------------------------
print_line(){
#	Функция печати строки из WIDTH символов "-"
	printf "%${WIDTH}s\n" | tr " " "-"
}

get_n_spaces(){
#	Функция возвращает сроку из N пробелов, где N это число переданных пробелов в $1
	printf "%${1}s"
}
#--------------------------------------------------------------------------------------------------------------
diff_len() {
#	Функция вычисления разницы между шириной WIDTH и длинной переданной строки
# 	используется для фунции ready
	charlen=$(echo "${1}" | sed -r "s/[\]033\[([0-9]{1,3}(;[0-9]{1,2})?)?[mGK]//g")
	charlen=${#charlen}
	echo $(( WIDTH - charlen ))
}

#--------------------------------------------------------------------------------------------------------------
ready() {
#	Функция печати строки состояния текущей операции исполнения
#	которая печатает переданную строку и оставляет курсор на этой же строке
        size=$(diff_len "${1}")
        printf "%b%-${size}s%b" "${1}"
}

print_error(){
	print_line
	echo -e "${RED}[ОШИБКА]${NOCL} ${1}"
	print_line
}
#--------------------------------------------------------------------------------------------------------------
when_ok() {
#	Функция работает в купе с ready и применяется следующим образом для примера:
#	ready 'Запускаем в работу...' {исполняемый код} && when_ok || when_err
#	печатает слово ГОТОВО зеленым цветом на одной строке с выводимым ready сообщением
# 	в случае, когда исполняемый код успешно выполнен
	ok_text=${1:-ГОТОВО}
	num_left=$((${#ok_text} + 2))
	to_left="\033[${num_left}D"
	echo -e "${to_left}${GREEN}${ok_text}${NOCL}"
}

#--------------------------------------------------------------------------------------------------------------
when_err() {
#	Функция работает в купе с ready и применяется следующим образом для примера:
#	ready 'Запускаем в работу...' {исполняемый код} && when_ok || when_err
#	печатает слово ОШИБКА красным цветом на одной строке с выводимым ready сообщением
# 	в случае, когда исполняемый код выполнен с ошибкой
	err_text=${1:-ОШИБКА}
	num_left=$((${#err_text} + 1))
	to_left="\033[${num_left}D"
	echo -e "${to_left}${RED}${err_text}${NOCL}"
}

#--------------------------------------------------------------------------------------------------------------
get_package_name(){
#	Функция возвращает имя пакета из передаваемой в нее ссылке на ipk пакет
	echo "${1}" | sed 's/.*\/\(.*ipk\)$/\1/'
}

# Из имени IPK извлекаем SemVer. Старый формат kvas_1.1.9_beta-10-47_all.ipk
# нормализуется до 1.1.9, поэтому переход на kvasec_1.2.0.ipk не требует force.
get_package_version(){
	echo "${1}" | sed -n \
		-e 's/^kvasec_\([0-9][0-9.]*\)\.ipk$/\1/p' \
		-e 's/^kvas_\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*_all\.ipk$/\1/p' | head -1
}

# SemVer → число для сравнения в BusyBox ash: 1.2.0 → 1002000.
version_key(){
	echo "${1}" | awk -F. '/^[0-9]+\.[0-9]+\.[0-9]+$/ { printf "%d%03d%03d", $1, $2, $3 }'
}

#--------------------------------------------------------------------------------------------------------------
select_release_from_list(){
#	Функция выводит на экран доступные в репозитории версии пакетов KVASEC
# 	и позволяет выбрать один из них в случае использования режима "отката"

	# только пакеты: рядом лежат .sha256, их в меню отката не показываем
	url_list=$(gh_api "${release_url}" | jq -r '.[] | .assets[] | select(.name | endswith(".ipk")) | .browser_download_url')
	rel_list=$(echo "${url_list}" | cut -d'/' -f8)
	num=1; total=$(echo "${rel_list}" | wc -l)

	if [ -n "${rel_list}" ]; then
		print_line
		echo -e "${GREEN}Список доступных релизов пакета KVASEC:${NOCL}"
		print_line
#		читаем данные из переменной со списком доступных релизов
#		и выводим их на экран, при этом крайняя версия пакета всегда в списке первая
		printf '%s\n' "${rel_list}" |
		while IFS= read -r release ; do
			[ "${num}" -eq 1 ] && latest="${release} ${BLUE}[новая версия]${NOCL}" || latest="${release}"
			n_spaces=$((${#total} - ${#num})); spaces=$(get_n_spaces "${n_spaces}")
			echo -e "${GREEN}${num}.${NOCL}${spaces} Версия ${latest}"
			num=$((num + 1))
		done

#		Производим выбор одного из доступных вариантов в списке релизов
		while true; do
			print_line
			echo -en "${QST}${GREEN} Введите номер из списка${NOCL} [1-${total}, Q-выход, Enter-новая версия]: "
			read -r num_release
			case "${num_release}" in
				[qQ])					# если выбрали выход
					print_error "Прервано пользователем!"
					exit 0 ;;
				'')						# если просто нажали Enter (выбираем 1 позицию - крайний релиз)
					print_line
					eval "${1}=$(echo "${url_list}" | sed -n '1p')"
					break ;;
				*[!0-9]*)				# не число
					print_line
					echo -e "${RED}Введите цифру от 1 до ${total}.${NOCL}" ;;
				*)						# номер из списка (не шаблон [1-N]: при N≥10 он ломался)
					if [ "${num_release}" -lt 1 ] || [ "${num_release}" -gt "${total}" ]; then
						print_line
						echo -e "${RED}Введите цифру от 1 до ${total}.${NOCL}"
					else
						print_line
						eval "${1}=$(echo "${url_list}" | sed -n "${num_release}p")"
						break
					fi ;;
				esac
		done
	fi
}

# ---------------------------------------------------------------------------------------------
# Удаляем пакет nano из системы если он установлен, вместо него установим nano-full
# ---------------------------------------------------------------------------------------------
remove_nano(){
	nano_name=$(opkg list-installed | grep 'nano ' | cut -d' ' -f1)
	[ -n "${nano_name}" ] && opkg --force-remove --force-depends remove "${nano_name}" &> /dev/null
}

#--------------------------------------------------------------------------------------------------------------
#	Переменные используемые в обновлении пакета
#--------------------------------------------------------------------------------------------------------------

# Ссылка на репозиторий на GitHub для получения крайней версии пакета
release_url=https://api.github.com/repos/shamanWeb/kvasec/releases
# Токен для приватного репозитория (необязателен, если релизы публичные).
# Положите fine-grained PAT (права: Contents-read) в файл ниже одной строкой.
GH_TOKEN_FILE=/opt/etc/kvas.github.token
[ -f "${GH_TOKEN_FILE}" ] && GH_TOKEN="$(cat "${GH_TOKEN_FILE}" 2>/dev/null | tr -d ' \r\n')" || GH_TOKEN=''
# Обёртка над curl к GitHub API с авторизацией, если задан токен
gh_api(){
	if [ -n "${GH_TOKEN}" ]; then
		curl -s -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${GH_TOKEN}" "$@"
	else
		curl -s -H "Accept: application/vnd.github+json" "$@"
	fi
}
# Скачивание ассета релиза. Для приватного репо browser_download_url недоступен
# без авторизации, поэтому при наличии токена качаем через api-url ассета (octet-stream).
gh_download(){
	# $1 = browser_download_url, $2 = имя файла назначения
	if [ -n "${GH_TOKEN}" ]; then
		dl_tag=$(echo "$1" | sed 's#.*/download/\([^/]*\)/.*#\1#')
		dl_file="${1##*/}"
		dl_api=$(gh_api "${release_url}/tags/${dl_tag}" | jq -r ".assets[]? | select(.name==\"${dl_file}\") | .url" | head -1)
		curl -fsL --retry 3 -H "Authorization: Bearer ${GH_TOKEN}" -H "Accept: application/octet-stream" "${dl_api}" -o "$2"
	else
		# -f: HTTP-ошибку (GitHub 504 и т.п.) не сохранять как файл пакета
		curl -fsL --retry 3 "$1" -o "$2"
	fi
}
# Проверка скачанного пакета ДО удаления установленной версии. Без неё 92-байтовая
# HTML-страница «504 Gateway Time-out» сходила за .ipk: старый KVASEC удалялся,
# новый не ставился, роутер оставался без kvas и веб-UI.
verify_package(){
	# $1 = путь к .ipk
	[ -s "$1" ] && gzip -t "$1" 2>/dev/null || return 1
	tar -tzf "$1" 2>/dev/null | grep -q 'data.tar.gz' || return 1
	# sha256 из релиза. Для версий ≥1.2.15 (у них есть .sha256) он ОБЯЗАТЕЛЕН: раньше
	# при неудачном скачивании .sha256 проверка молча пропускалась. Более старые
	# релизы (откат) публиковались без него — для них хватает gzip/tar.
	sum_file="/tmp/$(basename "$1").sha256"
	rm -f "${sum_file}"
	if gh_download "${package_url}.sha256" "${sum_file}" && [ -s "${sum_file}" ]; then
		want=$(cut -d' ' -f1 "${sum_file}")
		got=$(sha256sum "$1" | cut -d' ' -f1)
		rm -f "${sum_file}"
		[ -n "${want}" ] && [ "${want}" = "${got}" ] || return 1
	else
		rm -f "${sum_file}"
		# .sha256 публикуется с v1.2.15 — для них обязателен, откат на более старые без него
		_v=$(version_key "$(get_package_version "$(basename "$1")")")
		if [ -n "${_v}" ] && [ "${_v}" -ge 1002015 ]; then
			print_error "Не удалось получить SHA-256 пакета — установка отменена."
			return 1
		fi
	fi
	return 0
}
# Получаем ссылку на крайний релиз пакета на GitHub
package_url=$(gh_api "${release_url}/latest" | jq -r '.assets[]?.browser_download_url' | grep -E '/(kvasec_[0-9]+\.[0-9]+\.[0-9]+\.ipk|kvas_.*_all\.ipk)$' | sort | tail -1)
# Выделяем имя пакета из ссылки
package_name=$(get_package_name "${package_url}")
# путь к файлу конфигурации пакета KVASEC
kvas_conf=/opt/etc/kvas.conf
# Вычисляем текущую ширину экрана для печати линий определенной ширины
length=$(stty size 2>/dev/null | cut -d' ' -f2)
# длина распечатываемой линии символов будет меньше на 12 символов чем ширина экрана
case "${length}" in
	''|*[!0-9]*) WIDTH=68 ;;
	*) [ "${length}" -gt 80 ] && WIDTH=$((length*2/3)) || WIDTH=68 ;;
esac

sed -i 's/\(export TERM=\).*/\1xterm-256color/' /opt/etc/profile

#--------------------------------------------------------------------------------------------------------------
#
# 	Код исполнения файла
#
#--------------------------------------------------------------------------------------------------------------
# устанавливаем доступные переменные эскейп-последовательностей
set_escapes

#--------------------------------------------------------------------------------------------------------------
print_line	
ready "Проверка наличия интернета"
has_no_internet_here && {
	when_err "ОТСУТСТВУЕТ"
	print_error "Проверьте свое интернет соединение!"
	exit 1
} || when_ok "ГОТОВО"

#--------------------------------------------------------------------------------------------------------------
# если в параметрах есть аргумент full,
# то не важно на каком он месте мы делаем полное удаление пакета
if echo "${*}" | grep -q full ; then
	remove_mode=full
else
	remove_mode=''
fi

#--------------------------------------------------------------------------------------------------------------
# clear
#print_line
#--------------------------------------------------------------------------------------------------------------

# ищем в параметрах запуска файла наличие ниже перечисленных аргументов
if echo "${*}" | grep -qv 'force' ; then
#	Если это не форсированная установка , то проверяем дальше
	if echo "${*}" | grep -q 'rollback' ; then
#		Если параметр rollback значит
#		выбираем версию для обновления на предыдущую версию или "отката"
		print_line
		echo
		echo -e "${RED}[ВНИМАНИЕ]${NOCL} ${GREEN}Активирован режим возврата к предыдущей версии.${NOCL}"
		echo
		select_release_from_list package_url
		package_name=$(get_package_name "${package_url}")

	elif [ -f /opt/bin/kvas ] && [ -f ${kvas_conf} ]; then
	# Сравниваем SemVer, а не прежний номер сборки. Это сохраняет защиту от
	# даунгрейда и позволяет старому 1.1.9_beta-10-44 обновиться до 1.2.0.
		prev_version=$(grep '^APP_VERSION=' ${kvas_conf} | cut -d= -f2)
		next_version=$(get_package_version "${package_name}")
		prev_key=$(version_key "${prev_version}")
		next_key=$(version_key "${next_version}")
		if [ -n "${prev_key}" ] && [ -n "${next_key}" ] && [ "${next_key}" -le "${prev_key}" ] 2>/dev/null ; then
			print_error "KVASEC уже актуален (установлено ${prev_version}, в релизе ${next_version})."
			exit 1
		fi
	else
	#	Если НЕ обнаружена предыдущая версия KVASECа
	#	то это значит, что производим новую установку KVASECа
		:
	fi
fi

#--------------------------------------------------------------------------------------------------------------
# Получаем версию из имени файла (поддерживаются новый и старый форматы IPK).
version=$(get_package_version "${package_name}")
[ -n "${version}" ] || version="неизвестная"

# если в параметрах нет аргумента rollback, то выводим линию
echo "${*}" | grep -q 'rollback' && CL_VER=${RED} || { 
	print_line
	CL_VER=${BLUE}
}
# запускаем этап установки пакета
echo -e "${GREEN}Установка пакета KVASEC версии ${CL_VER}[${version}]${NOCL}"

# в случае отсутствия возможности создания новой папки
cd /opt && mkdir -p /opt/packages || {
	print_error "Невозможно создать папку ${BLUE}/opt/packages${NOCL}";
	exit 1
}
print_line

#--------------------------------------------------------------------------------------------------------------
ready 'Обновляем библиотеку пакетов opkg...'
{
	opkg update
} &>/dev/null && when_ok || when_err

# удаляем nano, чтобы поставить nano-full
remove_nano

#--------------------------------------------------------------------------------------------------------------
ready 'Загружаем пакет...'
{

	cd /opt/packages
	rm -f "/opt/packages/${package_name}"
	gh_download "${package_url}" "/opt/packages/${package_name}"

} &>/dev/null && when_ok || when_err
# пакет не скачался или битый — выходим, НЕ трогая установленную версию
verify_package "/opt/packages/${package_name}" || {
	rm -f "/opt/packages/${package_name}"
	print_error "Пакет не скачался или повреждён — установленная версия не тронута. Повторите позже."
	exit 1
}

#--------------------------------------------------------------------------------------------------------------
# Ставим ПОВЕРХ установленной версии, без предварительного `kvas uninstall`.
# Раньше: uninstall → install. Если install падал (лок opkg, нет места, зависимость) —
# kvas на роутере не оставалось; uninstall к тому же стирал /opt/etc/adblock (block.list
# родительского контроля — так он потерялся 2026-11-09), а восстановление конфигов делал
# только интерактивный `kvas setup`, который без TTY пропускается. postinst рассчитан на
# обновление: конфиги не затирает, перегенерирует libs/ndm, делает kvas init и
# перезапускает сторож. --force-downgrade — для отката на старую версию.
# `kvas upgrade … full` — явный запрос «переустановка с удалением данных»: только тогда
# сначала полностью удаляем (конфиги, списки) и после установки нужен `kvas setup`.
if [ "${remove_mode}" = full ] && [ -f /opt/bin/kvas ]; then
	ready 'Полностью удаляем установленную версию (режим full)...'
	kvas uninstall full yes &>/dev/null && when_ok || when_err
fi

ready "Устанавливаем новую версию пакета [${version}]..."
opkg update &> /dev/null
if opkg install --force-reinstall --force-downgrade "/opt/packages/${package_name}" > /tmp/kvas-upgrade-opkg.log 2>&1; then
	when_ok
else
	when_err
	print_error "opkg не установил пакет — работает прежняя версия. Лог: /tmp/kvas-upgrade-opkg.log"
	tail -5 /tmp/kvas-upgrade-opkg.log
	exit 1
fi


if ! [ -f /opt/bin/kvas ] ; then
	print_line
# 	если файл пакета не найден после установки пакета, значит произошла ошибка
	print_error "Пакет установлен некорректно - отсутствуют исполняемые файлы!"
	echo -e "${GREEN}Попробуйте установить пакет вручную командой "
	echo -e "${BLUE}'opkg update && opkg install /opt/packages/${package_name}'${NOCL}"
	print_line
	exit 1
else
	sleep 1
	curl -s "http://localhost:79/rci/opkg/dns-override" | grep -q true || {
		# Отключаем системный DNS-сервер роутера
		echo 'Отключаем работу через DNS-провайдера  роутера...'
		echo "Возможно, что сейчас произойдет выход из сессии..."
		echo "В этом случае необходимо заново войти в сессию по ssh"
		echo "и выполнить команду 'kvas setup ${UPDATE_MODE}'"
		rci_post '[{"opkg": {"dns-override": true}},{"system": {"configuration": {"save": true}}}]' &>/dev/null 
	}
	# Интерактивный `kvas setup` после обновления больше не нужен: пакет ставится поверх,
	# конфиги на месте, базовую настройку сделал postinst. (setup к тому же удаляет и
	# переустанавливает dnsmasq-full.) Если же первичная настройка не завершалась — просим.
	if ! grep -qE '^SETUP_FINISHED=.+' /opt/etc/kvas.conf 2>/dev/null ; then
		print_line
		echo "Первичная настройка пакета не завершена — запустите 'kvas setup' в терминале."
		print_line
	elif [ -t 0 ] ; then
		print_line
		echo 'Тестируем настройки...'
		kvas test upgrade
	fi
fi

rm -f upgrade install
