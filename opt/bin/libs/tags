#!/bin/sh
# ------------------------------------------------------------------------------------------
#
# 	ПРОЕКТ KVASEC
#
# 	Данный файл служит для обработки тегов
#   Реализованы такие функции:
#		- получение списка тегов
#		- получение списка доменных имен по тегу
#		- добавление доменного имени по тегу в список
#		- удаление доменного имени по тегу из списка
#
# ------------------------------------------------------------------------------------------
#
#
# ------------------------------------------------------------------------------------------

# . /opt/apps/kvas/bin/libs/main

# Файл с тегами: пользовательский /opt/etc/tags.list (его бэкапит upgrade и читает WebUI),
# пакетный — только шаблон; при первом обращении засеваем пользовательский из шаблона.
TAGS_DEFAULT_FILE=/opt/apps/kvas/etc/conf/tags.list
TAGS_FILE=/opt/etc/tags.list
[ -f "${TAGS_FILE}" ] || cp -f "${TAGS_DEFAULT_FILE}" "${TAGS_FILE}" 2>/dev/null
KVAS_LIST_FILE=/opt/etc/kvas.list

# ------------------------------------------------------------------------------------------
#
# 	Получаем список тегов и доменов
#
# ------------------------------------------------------------------------------------------
cmd_show_tags_domain_list(){

    section="$1"

    if [ -z "$section" ] ; then
        _list=$(cat < "${TAGS_FILE}")
    else
        grep -q "\[$section\]" "${TAGS_FILE}" || {
            error "Закваска '$section' не обнаружена!"
            return 1
        }
        _list=$(get_tag_domain_list "$section")

    fi


    echo -e "${GREEN}Список доменных имен в заквасках:${NOCL}"
    print_line
    [ -n "$section" ] && echo -e "${GREEN}[$section]${NOCL}"

    IFS=$'\n'
    for line in $_list; do
        if [[ "$line" =~ \[.*?\] ]]; then
            echo -e "  $line"
        else
            echo ''
            echo -e "${GREEN}${line}${NOCL}"

        fi
    done
    unset IFS

}


# ------------------------------------------------------------------------------------------
#
# 	Получаем список тегов
#
# ------------------------------------------------------------------------------------------
get_tags_list(){
    cat < "${TAGS_FILE}" | grep -vE '^#|^$' | grep "\[" | grep "\]" | tr -d ']['
}

# ------------------------------------------------------------------------------------------
#
# 	Получаем список доменных имен по тегу
#
# ------------------------------------------------------------------------------------------
get_tag_domain_list(){
    # точное сравнение заголовка: имя не подставляется в код awk
    awk -v s="[$1]" '{ l = $0; sub(/^[ \t]+/, "", l); sub(/[ \t\r]+$/, "", l) }
        l == s { flag = 1; next } /\[.*\]/ { flag = 0 } flag' "${TAGS_FILE}"
}

# ------------------------------------------------------------------------------------------
#
# 	Правка секции [tag] в TAGS_FILE (точное сравнение заголовков, не регэксп).
# 	$1 - тег, $2 - режим: delete (секцию целиком) | replace (содержимое на $3 —
# 	домены через пробел) | deldomain (строку = $3 внутри секции).
# 	Раньше sed "/\[tag\]/,/\[.*\]/ {d}" удалял и заголовок СЛЕДУЮЩЕЙ секции.
# 	Код возврата 1 — секция (или домен для deldomain) не найдены.
#
# ------------------------------------------------------------------------------------------
_tags_section_rewrite() {
    local tag="$1" mode="$2" arg="$3" tmp="${TAGS_FILE}.tmp.$$"
    awk -v s="[$tag]" -v mode="$mode" -v arg="$arg" '
        function trim(x) { sub(/^[ \t]+/, "", x); sub(/[ \t\r]+$/, "", x); return x }
        BEGIN { n = split(arg, repl, " ") }
        { l = trim($0); hdr = (l ~ /^\[.*\]$/) }
        hdr {
            insec = (l == s)
            if (insec) {
                found = 1
                if (mode == "delete") next
                print
                if (mode == "replace") for (i = 1; i <= n; i++) print repl[i]
                next
            }
        }
        insec && !hdr {
            if (mode == "delete" || mode == "replace") next
            if (mode == "deldomain" && l == arg) { hit = 1; next }
        }
        { print }
        END { exit !(mode == "deldomain" ? hit : found) }' "${TAGS_FILE}" > "${tmp}" \
        && mv -f "${tmp}" "${TAGS_FILE}" && return 0
    rm -f "${tmp}"
    return 1
}

tag_exists() {
    awk -v s="[$1]" '{ sub(/^[ \t]+/, ""); sub(/[ \t\r]+$/, "") } $0 == s { f = 1; exit } END { exit !f }' "${TAGS_FILE}" 2>/dev/null
}

# Имя закваски: идёт в заголовок [..] и в регэкспы старого кода — строгий whitelist
valid_tag_name() {
    [ -n "$1" ] && [ ${#1} -le 32 ] || return 1
    case "$1" in -*|*[!A-Za-z0-9_-]*) return 1 ;; esac
    return 0
}

# Домены закваски без пустых строк и комментариев
_tag_domains() {
    get_tag_domain_list "$1" | sed 's/#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d'
}

# ------------------------------------------------------------------------------------------
#
# 	Получаем первый домен из списка доменных имен по тегу
#
# ------------------------------------------------------------------------------------------
get_first_domain_from_section() {
    get_tag_domain_list "$1" | head -n 1
}

# ------------------------------------------------------------------------------------------
#
#   Функция для проверки наличия секции в файле
#
# ------------------------------------------------------------------------------------------
_check_section() {

    local section="$1"
    if ! grep -q "\[$section\]" "${TAGS_FILE}"; then
        read_ynq "Закваска '$section' не найдена. Добавить?" answer
        # shellcheck disable=SC2154  # присваивается по имени (eval) внутри read_ynq
        if [[ "$answer" =~ [qn] ]] ; then return 1;
        elif [[ "$answer" =~ [y] ]] ; then
            echo -e "\n[$section]" >> "${TAGS_FILE}"
        fi
        print_line

    fi

}

# ------------------------------------------------------------------------------------------
#
#   Функция для получения имени тега по имени домена
#
# ------------------------------------------------------------------------------------------
_get_tagname_by_domain() {
    local domain_name=$1

    # Найти строку с доменом и получить строки до этой строки, затем найти последний тег перед доменом
    sed -n "/^$domain_name$/=" "$TAGS_FILE" | while read -r line_number; do
        sed -n "1,${line_number}p" "$TAGS_FILE" | grep -oP '^\[\K[^\]]+' | tail -1
    done

}
# ------------------------------------------------------------------------------------------
#
#   Функция возврщает список доменных имен, помеченных одним тегом и
#   которых нет в защитном списке
#
# ------------------------------------------------------------------------------------------
_get_same_tag_domains_missing_in_protection_list() {

    local domain="$1"
    local tagname=$(_get_tagname_by_domain "${domain}" | tail -1)
    local _list=""

    get_tag_domain_list "$tagname" | while read -r line; do
        local _host=$(grep "^$line$" "${KVAS_LIST_FILE}")
        if [ -n "$_host" ]; then
            _list="${_list} ${line}"
        fi
    done

    echo "${_list}"
}
# ------------------------------------------------------------------------------------------
#
#   Функция для проверки домена на наличие доменной зоны
#
# ------------------------------------------------------------------------------------------
_check_domain_zone() {
    local domain="$1"

    # Проверка на наличие доменной зоны
    echo "$domain" | grep -qE "\.[a-zA-Z]{2,6}$" || {
        warning "Неверный формат домена."
        warning "Должна быть указана доменная зона (например, .com, .ru, .org)."
        return 1
    }


}

# ------------------------------------------------------------------------------------------
#
#   Функция для добавления домена в секцию
#
# ------------------------------------------------------------------------------------------
cmd_add_domain_to_tag_list() {

    local section="$1"
    local domain="$2"

    _check_domain_zone "${domain}" || return 1
    _check_section "$section" || return 1

    get_tag_domain_list "$section" | grep -q "^$domain$" && {
         warning "Домен '$domain' уже есть в закваске '$section'."
         warning "Пропускаем добавление домена в закваску '$section'..."
        return 1
    }

    ready "Домен '$domain' добавлен в закваску '$section'."
    if sed -i "/\[$section\]/a $domain" "${TAGS_FILE}" ;
    then when_ok "УСПЕШНО";
    else when_bad "ОШИБКА"; fi
}

# -------------------------------------------------------------------------------------------
#
#   Функция для удаления домена из секции
#
# ------------------------------------------------------------------------------------------
cmd_del_domain_from_tag_list() {

    local section="$1"
    local domain="$2"

    # Если задана только секция - удаляем все домены в этой секции
    if [ -z "${domain}" ] ; then
        read_ynq "Будут удалены все домены с закваской '$section' и само имя закваски.\nВы уверены?" answer
        # shellcheck disable=SC2154  # присваивается по имени (eval) внутри read_ynq
        if [[ "$answer" =~ [qn] ]] ; then return 1; fi
        [ "${answer}" = y ] && _tags_section_rewrite "$section" delete
        return
    else

        _check_domain_zone "${domain}" || return 1

        tag_exists "$section" || {
            echo "Закваска '$section' не найдена."
            return 1
        }

        _tags_section_rewrite "$section" deldomain "$domain" || {
            error "Домен '$domain' не обнаружен в закваске '$section'."
            return 1
        }
    fi
}


# --------------------------------------------------------------------------------------------
#
#   Функция для проверки наличия элементов тега в списке kvas
#
# ------------------------------------------------------------------------------------------
has_section_domains_in_list() {
#set -exu
    local section="$1"
    local action="${2}"
    _check_section "$section" || return 1

    local all_present=true
    local none_present=true
    local missing_elements=""

    [ -f "${KVAS_LIST_FILE}" ] || {
        # error "Файл '${KVAS_LIST_FILE}' не найден."
        when_bad "ОШИБКА"
        return 1
    }

    for domain in $(get_tag_domain_list "$section" | sed -e 's/^[[:space:]]*//; s/[[:space:]]*$//' ); do
# echo "$domain"
        if grep -q "^$domain$" "${KVAS_LIST_FILE}" ; then
            none_present=false
            #[ "$action" = "del" ] && none_present=true
        else
            all_present=false
            #[ "$action" = "del" ] && all_present=true
            missing_elements="${missing_elements}$domain "
        fi

    done
#echo "missing_elements=$missing_elements"
    if $all_present; then
        # when_ok "ДОБАВЛЕНА"
        echo 1
    elif $none_present; then
        # when_bad "ОТСУТСТВУЕТ"
        echo 2
    else
        # when_alert "ЧАСТИЧНО"
        echo 3
    fi
# set +exu
}

# --------------------------------------------------------------------------------------------
#
#   Функция для выбора секции из списка
#
# ------------------------------------------------------------------------------------------
tag_select() {

    local tags="$(get_tags_list)"
    local action="$1"

    echo -e "Список заквасок для ${BLUE}${action}${NOCL}:"

    if [ -z "${action}" ] ; then
        error "Не задан режим работы функции tag_select."
        return 1
    fi

    if [ "${action}" = "добавления" ] ; then action="add"; else action="del"; fi


    print_line
    local i=0
    local added_list=""
    local ask_list=""

#set -xeu
    while IFS= read -r tag; do

        local res=$(has_section_domains_in_list "$tag" "$action")

        if [ ${res} -gt 1 ] ; then

            if [ "${action}" = "add" ] ; then
		        i=$((i+1))
                ask_list="${ask_list}$(ready "$i. $tag")"
                [ "${res}" -eq 2 ] && ask_list="${ask_list}$(when_bad "ОТСУТСТВУЕТ")"
                [ "${res}" -eq 3 ] && ask_list="${ask_list}$(when_alert "ЧАСТИЧНО")"
                ask_list="${ask_list}\n"

            else
                if [ "${res}" -eq 2 ]; then
                    # Переводим в список отсутсвующих
                    #res=1
                    added_list="${added_list}$(ready "$tag")"
                    added_list="${added_list}$(when_alert "ОТСУТСТВУЕТ")\n"
                else
                    i=$((i+1))
                    ask_list="${ask_list}$(ready "$i. $tag")"
                    ask_list="${ask_list}$(when_alert "ЧАСТИЧНО")"
                    ask_list="${ask_list}\n"
                fi
            fi

        fi
        if [ ${res} = 1 ]; then
            # если домен уже есть в списке
            if [ "${action}" = "add" ] ; then
                added_list="${added_list}$(ready "$tag" && when_ok "ДОБАВЛЕН")\n"
            else
                i=$((i+1))
                ask_list="${ask_list}$(ready "$i. $tag")"
                if [ "${res}" -eq 1 ]; then
                    ask_list="${ask_list}$(when_bad "В СПИСКЕ")\n"
                fi
            fi
        fi
    done <<EOF
$tags
EOF


#set -xeu
    	[ -n "${added_list}" ] && {
        	echo -e "${added_list}" | sed '/^$/d'
        	[ -n "${ask_list}" ] && print_line
    	}
    	[ -n "${ask_list}" ] && {
            echo -e "${ask_list}" | sed '/^$/d'
        }

#    score=$(echo -e "${ask_list}" | wc -l)

    if [ "$i" -gt 0 ]; then
        print_line
        while true; do
	    local choice
            read -p "Выберите номер закваски из списка [1-$i], A:Все, Q:Выход: " choice

            [[ "${choice}" =~ [qQ] ]] && return 0
            [[ "${choice}" =~ [aA] ]] && break
#set -xeu
           # Проверка на ввод только цифр и в пределах диапазона
            if [[ "${choice}" =~ ^[0-9]+$ ]] && [ ${choice} -ge 1 ] && [ ${choice} -le ${i} ]; then
                break
            else
                error "Неверный ввод. Пожалуйста, введите номер из списка."
            fi

        done
#set -xeu
        if [[ "${choice}" =~ [aA] ]] ; then
            # если выбрано все
            eval "$2=ALL"
        else
	    #local _list=$([ "${action}" = add ] && echo "${ask_list}" || echo "${added_list}")
            chosen_tag=$(echo -e "${ask_list}" | sed -n $choice'p' | sed 's/^[0-9]\{1,3\}. \(.*\) .* .*$/\"\1\"/; /^$/d' | tr -d ' ' )
            eval "$2=$chosen_tag"
        fi

    else
        if [ "$(cat < "${TAGS_FILE}" | wc -l)" -le 1 ] ; then 
            error "Список заквасок пуст.\nПроверьте наличие заквасок в файле '${TAGS_FILE}'."
        else 
            print_line
            error "Заквасок для удаления не найдено."
        fi
    fi
#set +xeu
}

# --------------------------------------------------------------------------------------------
#
#   Функция для обновления списка заквасок с github
#
# ------------------------------------------------------------------------------------------
cmd_update_tags_domain_list() {

    local _force=${1:-no}
    ready "Обновление списка заквасок с ${BLUE}GitHub${NOCL}  прошло" 

    curl -so /opt/tmp/tags.list https://raw.githubusercontent.com/qzeleza/kvas/refs/heads/main/opt/etc/conf/tags.list && when_ok "УСПЕШНО" || {
        error "Не удалось обновить список заквасок с ${BLUE}GitHub${NOCL}."
        error "Пожалуйста, проверьте интернет соединение."
        return 1
    }
    
    if [ "${_force}" = force ] ; then
        mv -f /opt/tmp/tags.list "${TAGS_FILE}"
    else
        local _diff=$(diff "${TAGS_FILE}" /opt/tmp/tags.list  | grep -E '^\+\[' | tr -d +)
        if [ -n "${_diff}" ] ; then
            print_line
            echo -e "В список были добавлены следущие закваски:\n${_diff}"
            print_line
            printf "%s" "${_diff}"
            mv -f /opt/tmp/tags.list "${TAGS_FILE}"
        else
            print_line
            echo -e "В удаленном списке на ${BLUE}GitHub${NOCL} новых заквасок ${RED}не обнаружено${NOCL}."
            rm -f /opt/tmp/tags.list
        fi

    fi
}


# ------------------------------------------------------------------------------------------
#
#   Неинтерактивные команды для WebUI (manage.sh: tags_add/del/create/delete/edit_save).
#   Раньше этих подкоманд не было вовсе: `kvas tags add-protect` падал в ветку
#   показа списка с кодом 0, и WebUI рапортовал успех, ничего не сделав.
#
# ------------------------------------------------------------------------------------------
cmd_tags_add_protect() {
    local tag="$1" tmp
    valid_tag_name "$tag" && tag_exists "$tag" || { error "Закваска '$tag' не найдена."; return 1; }
    tmp=$(mktemp)
    _tag_domains "$tag" > "$tmp"
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        error "В закваске '$tag' нет доменов."
        return 1
    fi
    cmd_import_hosts "$tmp"
    rm -f "$tmp"
}

cmd_tags_del_protect() {
    local tag="$1" domains
    valid_tag_name "$tag" && tag_exists "$tag" || { error "Закваска '$tag' не найдена."; return 1; }
    domains=$(_tag_domains "$tag" | tr '\n' ' ')
    [ -n "$domains" ] || { error "В закваске '$tag' нет доменов."; return 1; }
    del_multy_hosts "$domains"
}

# $1 - имя, далее - домены
cmd_tags_create() {
    local tag="$1"; shift
    valid_tag_name "$tag" || { error "Недопустимое имя закваски '$tag'."; return 1; }
    tag_exists "$tag" && { error "Закваска '$tag' уже существует."; return 1; }
    [ $# -gt 0 ] || { error "Не заданы домены."; return 1; }
    { printf '\n[%s]\n' "$tag"; printf '%s\n' "$@"; } >> "${TAGS_FILE}" || return 1
    ready "Закваска '$tag' создана" && when_ok "ГОТОВО"
}

cmd_tags_delete() {
    local tag="$1"
    valid_tag_name "$tag" && _tags_section_rewrite "$tag" delete || {
        error "Закваска '$tag' не найдена."; return 1; }
    ready "Закваска '$tag' удалена" && when_ok "ГОТОВО"
}

# $1 - имя, далее - новый список доменов
cmd_tags_edit_save() {
    local tag="$1"; shift
    valid_tag_name "$tag" || { error "Недопустимое имя закваски '$tag'."; return 1; }
    [ $# -gt 0 ] || { error "Не заданы домены."; return 1; }
    _tags_section_rewrite "$tag" replace "$*" || { error "Закваска '$tag' не найдена."; return 1; }
    ready "Закваска '$tag' обновлена" && when_ok "ГОТОВО"
}
