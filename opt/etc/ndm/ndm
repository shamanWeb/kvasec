is_ppe_enabled() {
	#ToDo: научить и WHNAT
	if [ -z "${1}" ] ; then
		is_ppe_enabled 'hardware' || is_ppe_enabled 'software'
		return
	fi
	local engine="${1}"
	if [ "${engine}" != 'hardware' ] && [ "${engine}" != 'software' ] ; then
		error "[${FUNCNAME}] Передан неизвестный тип ускорителя ${engine}"
		return
	fi

	local param
	if ! is_os_below_4_2 ; then
		# no: yes
