# Целая KVAS_DNS — два DNAT (udp, tcp) на 127.0.0.1:${DNS_PORT}. Как и KVAS_MARK, после
# flush nat цепочка «есть», но пуста — раньше это считалось нормой, и прыжок вёл в
# пустую цепочку (DNS LAN не уходил на :9753).
# Создаёт (если нет) цепочку для DNS редиректа
ip4__dns__create_chain() {
	ndm_chain_lock
	_ip4__dns__create_chain
	ndm_chain_unlock
}

_ip4__dns__create_chain() {
	# ровно два DNAT (udp+tcp); задвоенную тоже пересобираем
	if [ "$(ipt_chain_rules "${TABLE_DNS}" "${CHAIN_DNS}" | grep -cF -- "127.0.0.1:${DNS_PORT}")" -eq 2 ]; then
		return
	fi

	if ip4__chain__is_exist "${TABLE_DNS}" "${CHAIN_DNS}" ; then
		log_warning 'Цепочка DNS перенаправления пуста или неполна — пересобираем'
		/opt/sbin/iptables -w -t "${TABLE_DNS}" -F "${CHAIN_DNS}"
	else
		log_warning 'Создание цепочки для DNS перенаправления'
		/opt/sbin/iptables -N "${CHAIN_DNS}" -w -t "${TABLE_DNS}"
	fi

	# НЕ исключаем route_excluded_ip из DNS-редиректа: иначе устройство в режиме
	# «Напрямую» теряет DNS (kvas dnsmasq слушает только :9753, а на :53 для
	# не-завёрнутых клиентов ответа нет). «Напрямую» должно убирать устройство
	# только из туннеля (KVAS_MARK), но DNS по-прежнему резолвить через kvas.
	# ip4__chain__exclude_source_by_config "${TABLE_DNS}" "${CHAIN_DNS}"

	IFS=' '
	for protocol in udp tcp ; do
		/opt/sbin/iptables -w -A "${CHAIN_DNS}" -t "${TABLE_DNS}" -p "${protocol}" --dport 53 -j DNAT --to-destination 127.0.0.1:"${DNS_PORT}"
	done
}

# Возвращает номер (в nat PREROUTING) по куску правила
#Example input param: NDM_UPNP_REDIRECT_SYS
ip4__get_rulenum() {
	if [ -z "${1}" ]; then
		error "[${FUNCNAME}] Не передан обязательный параметр — правило для поиска"
		return
	fi
	local find="${1}"

	# если потребуются другие таблицы или цепочки, можно сделать их входящими параметрами
	local table='nat'
	local chain='PREROUTING'

	# shellcheck disable=SC2046  # намеренно: echo $(...) склеивает вывод в одну строку
	echo $(ipt_chain_rules "${table}" "${chain}" \
	 | grep -nF -- "${find}" | head -n 1 | grep -oE '^[0-9]+')
}

# Возвращает номер (в PREROUTING) для DNS-правил
ip4__dns__get_rulenum() {
	# вместо NDM_DNS_REDIRECT
	local rulenum=$(ip4__get_rulenum 'NDM_DNS_REDIRECT')
	if [ -n "${rulenum}" ]; then
		echo "${rulenum}"
		return
	fi

	# после NDM_DNAT
	rulenum=$(ip4__get_rulenum 'NDM_DNAT')
	if [ -n "${rulenum}" ]; then
		echo $((rulenum + 1))
		return
	fi

	# высший приоритет
	# если DNS перехват не будет работать, удаляем вышестоящее
	echo '1'
}

# Перенаправляем dns-запросы в dnsmasq
#Example input param:-s 192.168.3.0/24 -i eth3
#Example input param:-i sstp+
ip4__dns__add_routing() {
	local IFS=' '   # строку правила режем по пробелам — см. iptables__delete_rule
	local iptables_filter
	local submessage
	if [ -n "${1}" ]; then
		iptables_filter=$(echo "${1}" | xargs)
		submessage=" по критерию ${iptables_filter}"
		iptables_filter=" ${iptables_filter}"
	else
		iptables_filter=''
		submessage=''
	fi

	# Цепочку проверяем/чиним ДО проверки прыжка: после flush nat прыжок есть, а
	# KVAS_DNS пуста — раньше функция выходила раньше, и цепочка не восстанавливалась.
	ip4__dns__create_chain

	if ipt_chain_rules "${TABLE_DNS}" PREROUTING | grep -F -- "${iptables_filter}" | grep -Fq -- "-j ${CHAIN_DNS}" ; then
		return
	fi
	local rulenum
	rulenum=$(ip4__dns__get_rulenum)

	log_warning "Подключение DNS перенаправления с приоритетом ${rulenum}${submessage}"
	# без echo дублирование пробелов (что даёт warning и проблему наличия)
	# shellcheck disable=SC2046  # намеренно: строка разбивается на аргументы
	/opt/sbin/iptables -I PREROUTING "${rulenum}" -w -t "${TABLE_DNS}"$(echo "${iptables_filter}") -j "${CHAIN_DNS}"
}

# Отключение перехвата dns-запросов в dnsmasq
#Example input param:-s 192.168.3.0/24 -i eth3
#Example input param:-i sstp+
ip4__dns__delete_routing() {
	local IFS=' '   # строку правила режем по пробелам — см. iptables__delete_rule
	local iptables_filter
	local submessage
	if [ -n "${1}" ]; then
		iptables_filter=$(echo "${1}" | xargs)
		submessage=" по критерию ${iptables_filter}"
		iptables_filter=" ${iptables_filter}"
	else
		iptables_filter=''
		submessage=''
	fi

	if ! ipt_chain_rules "${TABLE_DNS}" PREROUTING | grep -F -- "${iptables_filter}" | grep -Fq -- "-j ${CHAIN_DNS}" ; then
		return
	fi

	log_warning "Отключение DNS перенаправления${submessage}"

	# без echo дублирование пробелов (что даёт warning и проблему наличия)
	# shellcheck disable=SC2046  # намеренно: строка разбивается на аргументы
	/opt/sbin/iptables -w -D PREROUTING -t "${TABLE_DNS}"$(echo "${iptables_filter}") -j "${CHAIN_DNS}"
}


