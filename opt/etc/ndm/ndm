ip4__dnat_to_port__create_chain() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — таблица"
		return
	fi
	local table="${1}"

	if [ -z "${2}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — цепочка"
		return
	fi
	local chain_name="${2}"

	if [ -z "${3}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — порт"
		return
	fi
	local port="${3}"

	{
		if ip4__chain__is_exist "${table}" "${chain_name}" ; then
			return
		fi

		ip4__chain__create_for_data "${table}" "${chain_name}"

		IFS=' '
		for protocol in udp tcp ; do
			# не будет ли задвоения без -w?
			/opt/sbin/iptables -A "${chain_name}" -t "${table}" -p "${protocol}" -j REDIRECT --to-port "${port}"
		done
	} &>/dev/null || error "[${FUNCNAME}] Возникли ошибки при установке правил трафика для прокси"
}

ip4__shadowsocks__create_chain() {
	local local_port
	local_port=$(get_config_value SSR_DNS_PORT)

	ip4__dnat_to_port__create_chain "${TABLE_DNAT_TO_PORT}" "${CHAIN_DNAT_TO_PORT}" "${local_port}"
}

# Сборку KVAS_MARK/KVAS_DNS сериализуем: её одновременно запускают хук NDM, сторож и
# kvas init — каждый видел «цепочка неполна» и дописывал свой комплект (после установки
# пакета было 18 правил вместо 9). mkdir-лок; брошенный (процесс убит) — по возрасту
# самого лока, снос атомарным mv. Внутри лока целостность проверяется заново.
KVAS_CHAIN_LOCK=/tmp/kvas-ndm-chain.lock
ndm_chain_lock() {
	local born
	while ! mkdir "${KVAS_CHAIN_LOCK}" 2>/dev/null; do
		born=$(date -r "${KVAS_CHAIN_LOCK}" +%s 2>/dev/null) || continue
		if [ $(( $(date +%s) - born )) -gt 60 ] &&
			mv "${KVAS_CHAIN_LOCK}" "${KVAS_CHAIN_LOCK}.stale.$$" 2>/dev/null; then
			rm -rf "${KVAS_CHAIN_LOCK}.stale.$$"
			continue
		fi
		sleep 1
	done
}
ndm_chain_unlock() { rmdir "${KVAS_CHAIN_LOCK}" 2>/dev/null; }

ip4__mark__create_chain() {
	ndm_chain_lock
	_ip4__mark__create_chain
	ndm_chain_unlock
}

_ip4__mark__create_chain() {
	{
		# Целая KVAS_MARK заканчивается CONNMARK --save-mark. Раньше достаточно было
		# «цепочка существует» — а NDM при reload делает -F: пустая цепочка оставалась
		# пустой (прыжок из PREROUTING в никуда → трафик KVAS_LIST мимо туннеля), и
		# сторож, вызывая этот хук, ничего не мог восстановить.
		# ровно ОДИН --save-mark: задвоенную (гонка, см. ndm_chain_lock) тоже пересобираем
		if [ "$(ipt_chain_rules "${TABLE_MARK}" "${CHAIN_MARK}" | grep -c -- '--save-mark')" -eq 1 ] ; then
			return
		fi
		if ip4__chain__is_exist "${TABLE_MARK}" "${CHAIN_MARK}" ; then
			log_warning "Цепочка ${CHAIN_MARK} пуста или неполна — пересобираем"
			/opt/sbin/iptables -w -t "${TABLE_MARK}" -F "${CHAIN_MARK}"
		fi

		ip4__chain__create_for_data "${TABLE_MARK}" "${CHAIN_MARK}"

		# т.к. мы начнём маркировать трафик, то заранее
		# стартанём таблицы для него и повесим правило захвата
		ip4__route__add_table
		ip4__rule__add_mark_to_table

		log_warning 'Включение маркировки AmneziaWG'

			# Не переносим маркер для каждого пакета в случае TCP.
			# На отдельных устройствах, к сожалению, не работает.
			#/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -p tcp -m conntrack ! --ctstate NEW -j RETURN

			# restore/save-mark без масок работают со всеми 32 битами. Проверено на роутере
			# (2026-11-20): кроме kvas, fwmark/connmark никто не ставит (у NDM — только
			# проверка --mark 0x0; её NDMMARK — отдельный механизм), в conntrack метки
			# только 0 и 0xd1000 — конфликта нет. Если появится второй пользователь меток —
			# перейти на --nfmask/--ctmask 0xd1000 и --set-xmark 0xd1000/0xd1000.
			/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -j CONNMARK --restore-mark
			/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -m mark --mark ${MARK_NUM} -j RETURN

			#/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" ! -p tcp -m conntrack ! --ctstate NEW -j RETURN
		/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -m conntrack ! --ctstate NEW -j RETURN
		/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -j MARK --set-mark ${MARK_NUM}
		/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -j CONNMARK --save-mark
