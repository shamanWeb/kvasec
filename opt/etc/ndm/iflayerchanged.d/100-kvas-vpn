#!/bin/sh
# shellcheck disable=SC2154  # $id/$change/$layer/$table/… приходят из окружения NDM
# ------------------------------------------------------------------------------------------
#
# 	ПРОЕКТ KVASEC
#
# ------------------------------------------------------------------------------------------
# 	Данный файл служит основной библиотекой функций пакета KVASEC
# ------------------------------------------------------------------------------------------
# ------------------------------------------------------------------------------------------

#	Подключаем библиотеку с функциями обработки ndm
. /opt/apps/kvas/bin/libs/ndm_d

cli_inface="$(inface_cli)"

# ИЗВЕСТНАЯ ПРОБЛЕМА: для opkgtun-туннелей (AmneziaWG вне NDM) cli_inface пуст, и
# `grep -q ""` совпадает с ЛЮБЫМ интерфейсом — ctrl-disabled гостевого Wi-Fi и т.п.
# дёргает сброс маршрутизации kvas. Нужна точная проверка и выход при пустом cli_inface.
# (build.sh этот хук не ставит; опасен, если остался на роутере от старой версии.)
if [ "${1}" = "hook" ] && echo "${id}" | grep -q "${cli_inface}"; then

	case "${layer}-${level}" in

#		Запускаем обработку при поднятии соединения
		"ctrl-running")
			cmd_vpn_iptable_reset &> /dev/null
#			link_up &> /dev/null
			logger -t "KVASEC"  "Соединение ${id} успешно подключено."
		;;

#		Запускаем обработку при отключении соединении
		"ctrl-disabled" )
			link_reboot "${cli_inface}" &> /dev/null
			logger -t "KVASEC"  "Соединение ${id} успешно завершено."
		;;

	esac

fi
