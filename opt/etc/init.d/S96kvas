#!/bin/sh

#------------------------------------------------------------------------------
#
#	ПАКЕТ KVASEC
#
#------------------------------------------------------------------------------
#
#	Данный файл служит для начального запуска пакета квас при загрузке системы
#	https://github.com/ndmsystems/packages/wiki/Opkg-Component с командой start
#	основными задачами являются:
#
#	1. Создание таблицы ipset ip4
#	2. Загрузка таблицы ipset доменными именами
#
# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------

case ${1} in
	start|restart)
		# Износ флеша: /opt/tmp держим в RAM (tmpfs /tmp), а не на USB-флеше.
		# dpi_history.sh (cron * * * * *) и временные файлы adblock/загрузок иначе
		# пишут на флеш каждую минуту. Идемпотентно: чиним симлинк, если апгрейд
		# или распаковка ipk вернули обычную папку. /tmp смонтирован ядром заранее.
		if [ ! -L /opt/tmp ]; then
			rm -rf /opt/tmp 2>/dev/null
			ln -s /tmp /opt/tmp
		fi
		. /opt/apps/kvas/bin/libs/vpn
		cmd_kvas_init no
		# Автозапуск Web UI после ребута, если был включён (флаг в /opt/etc — persistent)
		[ -f /opt/etc/kvas-monitor-web-enabled ] && \
			/opt/apps/kvas/bin/kvas monitor web >/dev/null 2>&1 &
	;;
esac
